    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^1.0.0-rc.4",
    "lucide-react": "^1.55.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
